@startuml HusaresClassDiagram
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam groupInheritance 2
skinparam dpi 50

hide empty members

' ─────────────────────────────────────────
' GLOBAL
' ─────────────────────────────────────────
package "Global" #F0F0FF {

  class DamageInfo <<struct>>
  class KeyTimelinePair <<struct, Serializable>>
  class HistoricalEvent <<struct, Serializable>>

  enum TimelineID
  enum HistoricalEventType
}

' ─────────────────────────────────────────
' CUTSCENES
' ─────────────────────────────────────────
package "Cutscenes" #FFF8E0 {

  enum CutsceneActionType

  class CutsceneAction <<Serializable>>
  class CutscenePart <<Serializable>>
  class Cutscene <<ScriptableObject>>
  class CutsceneManager
  class TimelineManager
}

' ─────────────────────────────────────────
' UI
' ─────────────────────────────────────────
package "UI" #F0FFF0 {

  class LevelUIManager
  class MainMenuManager
  class RetryMenuManager
}

' ─────────────────────────────────────────
' WEAPON
' ─────────────────────────────────────────
package "Weapon" #FFFFF0 {

  abstract class GenericWeapon
  class WeaponRifle
  class WeaponMelee
  class BulletImpact
  class GenericWpnHolster
  class WpnPickup
}

' ─────────────────────────────────────────
' FLAVOR / INTERACTABLES
' ─────────────────────────────────────────
package "Flavor" #F5F0FF {

  class Interactable
  class FlavorText
  class CutsceneTrigger
  class HistoricalBattleManager
}

' ─────────────────────────────────────────
' HISTORICAL
' ─────────────────────────────────────────
package "Historical" #FFF0F8 {

  class HistoricalBattleScenario <<ScriptableObject>>
}

' ─────────────────────────────────────────
' CHARACTER – PLAYER
' ─────────────────────────────────────────
package "Character.Player" #E8F8FF {

  class FPSController
  class Inputs
  class PlayerHitbox
}

' ─────────────────────────────────────────
' CHARACTER – ENEMY
' ─────────────────────────────────────────
package "Character.Enemy" #FFF0E8 {

  enum EnemyState
  enum TroopState

  class EnemyController
  class EnemyWeaponHandler
  class EnemyEntity
  class LineOfSight
  class NPCHearingManager
  class TroopController
  class CoverBarricade
}

' ─────────────────────────────────────────
' CHARACTER – PATHFINDING
' ─────────────────────────────────────────
package "Character.Pathfinding" #F0FFF8 {

  class Path
  class AStarGrid
  class NPCRoutine
}

' ═══════════════════════════════════════════
' RELATIONSHIPS
' ═══════════════════════════════════════════

' --- Inheritance ---
GenericWeapon       <|-- WeaponMelee
GenericWeapon       <|-- WeaponRifle
Interactable        <|-- WpnPickup
Interactable        <|-- FlavorText
Interactable        <|-- CutsceneTrigger

' --- Global ---
KeyTimelinePair     -->  TimelineID
HistoricalEvent     -->  HistoricalEventType

' --- Cutscene structure ---
Cutscene            "1" *-- "many" CutscenePart
Cutscene            "1" *-- "many" CutsceneAction
CutsceneAction      -->  CutsceneActionType
CutsceneManager     -->  Cutscene
CutsceneManager     -->  LevelUIManager
CutsceneTrigger     -->  CutsceneManager
TimelineManager     "1" *-- "many" KeyTimelinePair
TimelineManager     ..>  TimelineID                   : <<indexes by>>

' --- Player ---
FPSController       -->  GenericWeapon
FPSController       -->  GenericWpnHolster
FPSController       -->  Inputs
FPSController       -->  BulletImpact
FPSController       -->  LevelUIManager
FPSController       -->  TimelineManager
PlayerHitbox        -->  FPSController
PlayerHitbox        ..>  DamageInfo                   : <<receives>>

' --- Holster ---
GenericWpnHolster   "1" o-- "many" GenericWeapon
GenericWpnHolster   -->  Inputs
GenericWpnHolster   -->  FPSController

' --- Weapon firing ---
GenericWeapon       -->  NPCHearingManager
GenericWeapon       ..>  TimelineID                   : <<uses>>
WeaponMelee         -->  BulletImpact
WeaponMelee         ..>  DamageInfo                   : <<creates>>
WeaponRifle         -->  BulletImpact
WeaponRifle         ..>  DamageInfo                   : <<creates>>

' --- Enemy ---
EnemyController     -->  EnemyWeaponHandler
EnemyController     -->  GenericWeapon
EnemyController     -->  TroopController
EnemyController     -->  AStarGrid
EnemyController     ..>  DamageInfo                   : <<receives>>
EnemyWeaponHandler  "1" o-- "many" GenericWeapon
EnemyWeaponHandler  -->  EnemyController
EnemyWeaponHandler  -->  TimelineManager
TroopController     "1" o-- "many" EnemyController
TroopController     "1" o-- "many" CoverBarricade
TroopController     ..>  TroopState
LineOfSight         -->  EnemyController
EnemyController     ..>  EnemyState

' --- Historical ---
HistoricalBattleManager -->  TroopController
HistoricalBattleManager ..>  HistoricalEvent              : <<handles>>
HistoricalBattleScenario "1" *-- "many" HistoricalEvent

' --- Pathfinding ---
Path                -->  Path                         : next
AStarGrid           ..>  Path                         : <<creates>>
EnemyController     o--  Path                         : route

' --- Interactable callbacks ---
FlavorText          ..>  FPSController                : <<Interact()>>
CutsceneTrigger     ..>  FPSController                : <<Interact()>>

@enduml
